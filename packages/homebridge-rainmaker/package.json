{
  "name": "homebridge-rainmaker",
  "displayName": "Rainmaker",
  "version": "0.0.0",
  "description": "Siri, Alexa and Home app control of OpenSprinkler controllers through the Rainmaker hub.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "config.schema.json"
  ],
  "keywords": [
    "homebridge-plugin",
    "opensprinkler",
    "irrigation",
    "sprinkler"
  ],
  "engines": {
    "homebridge": "^1.8.0 || ^2.0.0",
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.js --external:ws --external:bonjour-service --external:homebridge"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@rainmaker/controller-sim": "*",
    "@rainmaker/hub-core": "*",
    "homebridge": "^2.4.0"
  }
}
